{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "cred-vault-6bf20",
          "appId": "1:819631877981:android:6c579339ea54a5351d42b4",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "cred-vault-6bf20",
          "configurations": {
            "android": "1:819631877981:android:6c579339ea54a5351d42b4",
            "ios": "1:819631877981:ios:038b77798bb08ee11d42b4",
            "web": "1:819631877981:web:b6c5994304e9b6981d42b4"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|woff2|ttf|png|jpg|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/@(index.html|flutter_service_worker.js|version.json|manifest.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}